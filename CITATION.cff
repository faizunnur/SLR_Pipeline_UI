    given-names: "Md Faizun Nur"
version: "1.2.2"
date-released: "2026-11-27"
license: "MIT"
repository-code: "https://github.com/faizunnur/SLR_Pipeline_UI"
keywords:
  - systematic literature review
  - PRISMA 2020
  - citation verification
  - provenance
  - research software
  - desktop application
references:
