        given-names: "Md Nayeem"
    version: "1.3.4"
    date-released: "2026-11-25"
    license: "MIT"
    repository-code: "https://github.com/nayeem-hossain/slr-pipeline"
    notes: "The pipeline (search, dedup, screening, extraction, appraisal, reporting) that slr-pipeline-ui is built on."
